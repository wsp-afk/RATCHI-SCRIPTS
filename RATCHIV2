local function getHealthColor(ratio)
    ratio = math.clamp(ratio, 0, 1)
    if ratio > 0.5 then
        local t = (ratio - 0.5) * 2
        return Color3.fromRGB(255, 220, 0):Lerp(Color3.fromRGB(40, 220, 90), t)
    else
        local t = ratio * 2
        return Color3.fromRGB(235, 50, 50):Lerp(Color3.fromRGB(255, 220, 0), t)
    end
end

local function formatHealth(health)
    local rounded = math.floor(health * 10 + 0.5) / 10
    if rounded == math.floor(rounded) then
        return tostring(math.floor(rounded))
    end
    return string.format("%.1f", rounded)
end

local function removeESP(player)
    if espByPlayer[player] then
        espByPlayer[player]:Destroy()
        espByPlayer[player] = nil
    end
end

