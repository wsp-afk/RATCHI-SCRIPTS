RunService.RenderStepped:Connect(function()
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    for player, billboard in pairs(espByPlayer) do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if root and humanoid and humanoid.Health > 0 then
            billboard.Adornee = root
            billboard.Enabled = true

            local maxHealth = math.max(humanoid.MaxHealth, 1)
            local currentHealth = math.clamp(humanoid.Health, 0, maxHealth)
            local ratio = currentHealth / maxHealth
            local hpColor = getHealthColor(ratio)

            local extrasGroup = billboard.ExtrasGroup
            extrasGroup.NameLabel.Text = string.format("%s (@%s)", player.DisplayName, player.Name)
            extrasGroup.HpCounter.Text = formatHealth(currentHealth)
            extrasGroup.HpCounter.TextColor3 = hpColor

            extrasGroup.HpBarBg.HpBarFill.Size = UDim2.new(1, 0, ratio, 0)
            extrasGroup.HpBarBg.HpBarFill.BackgroundColor3 = hpColor

            if myRoot then
                local distance = math.floor((myRoot.Position - root.Position).Magnitude)
                extrasGroup.DistanceLabel.Text = string.format("%dm", distance)

                local alpha = math.clamp(distance / MAX_DISTANCE, 0, 1)
                extrasGroup.ExtrasScale.Scale = MIN_SCALE + (MAX_SCALE - MIN_SCALE) * alpha
            else
                extrasGroup.DistanceLabel.Text = "-"
                extrasGroup.ExtrasScale.Scale = MIN_SCALE
            end
        else
            billboard.Adornee = nil
            billboard.Enabled = false
        end
    end
end)

local StarterGui = game:GetService("StarterGui")

local DEFAULT_ICON_ID = 127087857486157
local DEFAULT_DURATION = 5

local function sendNotification(title, text, duration, iconId)
    local payload = {
        Title = tostring(title or "Notification"),
        Text = tostring(text or ""),
        Duration = duration or DEFAULT_DURATION,
        Icon = "rbxassetid://" .. tostring(iconId or DEFAULT_ICON_ID),
    }

    for _ = 1, 10 do
        local success = pcall(function()
            StarterGui:SetCore("SendNotification", payload)
        end)
        if success then
            return true
        end
        task.wait(0.5)
    end

    return false
end

